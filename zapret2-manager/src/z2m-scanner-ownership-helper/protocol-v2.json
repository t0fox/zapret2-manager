{
  "protocolVersion": 2,
  "transport": {
    "lifecycle": "short_lived",
    "requestChannel": "stdin",
    "responseChannel": "stdout",
    "diagnosticsChannel": "stderr",
    "requestCount": 1,
    "responseCount": 1,
    "requestMaxBytes": 4096,
    "responseMaxBytes": 4096,
    "responseTerminator": "\n",
    "diagnostics": "redacted",
    "inputEncoding": "utf-8",
    "invalidUtf8": "reject",
    "duplicateKeys": "reject",
    "trailingData": "reject",
    "trailingWhitespace": "allow",
    "embeddedNul": "reject"
  },
  "envelopes": {
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocolVersion", "requestId", "operation", "arguments"],
      "properties": {
        "protocolVersion": { "const": 2 },
        "requestId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9._:-]+$" },
        "operation": { "type": "string", "enum": ["ownership_create", "ownership_ready", "ownership_delete", "ownership_status"] },
        "arguments": { "type": "object" }
      }
    },
    "success": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocolVersion", "requestId", "ok", "data"],
      "properties": {
        "protocolVersion": { "const": 2 },
        "requestId": { "type": "string" },
        "ok": { "const": true },
        "data": { "type": "object" }
      }
    },
    "failure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocolVersion", "requestId", "ok", "error"],
      "properties": {
        "protocolVersion": { "const": 2 },
        "requestId": { "type": ["string", "null"] },
        "ok": { "const": false },
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "message", "retryable", "committed", "durability", "stage"],
          "properties": {
            "code": { "type": "string", "enum": ["EMALFORMED", "ESCHEMA", "EREQUESTTOOBIG", "EDENIED", "EOWNERSHIP", "EINTERNAL"] },
            "message": { "type": "string", "maxLength": 512 },
            "retryable": { "type": "boolean" },
            "committed": { "type": ["boolean", "null"] },
            "durability": { "enum": ["unchanged", "durable", "unknown", "not_applicable"] },
            "stage": { "type": "string", "minLength": 1, "maxLength": 64 },
            "details": { "type": "object" }
          }
        }
      }
    }
  },
  "requestIdentity": {
    "beforeRequestIdValidation": "null",
    "afterRequestIdValidation": "echo_exactly",
    "successRequiresValidatedRequestId": true,
    "failureRequiresValidatedRequestIdOrNull": true
  },
  "exitCategories": {
    "success": 0,
    "request_invalid": 2,
    "policy_denied": 3,
    "internal": 70,
    "response_incomplete": 74
  },
  "operations": {
    "ownership_create": {
      "milestone": 5,
      "status": "defined",
      "requestSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["tableName", "ownerToken"],
        "properties": {
          "tableName": { "type": "string", "maxLength": 62, "pattern": "^z2m_sc_[0-9a-f]{8}_[0-9a-f]{8}_[0-9a-f]{4}_[0-9a-f]{32}$" },
          "ownerToken": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        }
      },
      "successSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["created", "tableName"],
        "properties": {
          "created": { "const": true },
          "tableName": { "type": "string" }
        }
      },
      "limits": { "maxInputBytes": 256, "maxOutputBytes": 256, "timeoutMsMax": 5000 },
      "constraints": "NFT_TABLE_F_OWNER only; no PERSIST; fail-closed on any uncertainty; delete is primary primitive."
    },
    "ownership_ready": {
      "milestone": 5,
      "status": "defined",
      "requestSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["tableName", "ownerToken"],
        "properties": {
          "tableName": { "type": "string", "maxLength": 62, "pattern": "^z2m_sc_[0-9a-f]{8}_[0-9a-f]{8}_[0-9a-f]{4}_[0-9a-f]{32}$" },
          "ownerToken": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        }
      },
      "successSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ready", "tableName"],
        "properties": {
          "ready": { "const": true },
          "tableName": { "type": "string" }
        }
      },
      "limits": { "maxInputBytes": 256, "maxOutputBytes": 256, "timeoutMsMax": 5000 },
      "constraints": "Verify NFT_TABLE_F_OWNER match; fail-closed; no userspace list/get/check."
    },
    "ownership_delete": {
      "milestone": 5,
      "status": "defined",
      "requestSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["tableName", "ownerToken"],
        "properties": {
          "tableName": { "type": "string", "maxLength": 62, "pattern": "^z2m_sc_[0-9a-f]{8}_[0-9a-f]{8}_[0-9a-f]{4}_[0-9a-f]{32}$" },
          "ownerToken": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        }
      },
      "successSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["deleted", "tableName"],
        "properties": {
          "deleted": { "type": "boolean" },
          "tableName": { "type": "string" }
        }
      },
      "limits": { "maxInputBytes": 256, "maxOutputBytes": 256, "timeoutMsMax": 5000 },
      "constraints": "Delete is primary ownership primitive; NFT_TABLE_F_OWNER verification; fail-closed; bounded helper never owns journal/lifecycle/state."
    },
    "ownership_status": {
      "milestone": 5,
      "status": "defined",
      "requestSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["tableName", "ownerToken"],
        "properties": {
          "tableName": { "type": "string", "maxLength": 62, "pattern": "^z2m_sc_[0-9a-f]{8}_[0-9a-f]{8}_[0-9a-f]{4}_[0-9a-f]{32}$" },
          "ownerToken": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        }
      },
      "successSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["exists", "owned", "tableName"],
        "properties": {
          "exists": { "type": "boolean" },
          "owned": { "type": "boolean" },
          "tableName": { "type": "string" }
        }
      },
      "limits": { "maxInputBytes": 256, "maxOutputBytes": 256, "timeoutMsMax": 5000 },
      "constraints": "Status only after explicit ownership evidence; no broad privileged daemon; NFQUEUE ownership remains separate."
    }
  },
  "constraints": {
    "ownershipSafety": "fail-closed on any uncertainty",
    "noUserspaceGetListCheck": true,
    "deletePrimaryPrimitive": true,
    "boundedHelperLimits": "never owns product journal, Scanner lifecycle, reconciliation policy, or permanent state",
    "canonicalJournalWriter": "ucode Scanner/Task 7",
    "tableNameMax": 62,
    "tableNamePattern": "z2m_sc_<sid8>_<cid8>_<gen4>_<nonce32>",
    "nftFlags": "NFT_TABLE_F_OWNER only; no PERSIST by default",
    "nfqueue": "separate proof obligation",
    "noBroadDaemon": true,
    "noArbitraryNft": true
  }
}
