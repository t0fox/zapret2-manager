#!/bin/sh /etc/rc.common
# init.d/zapret2-manager — native broker and watchdog daemons (branch 06).
#
# This init never starts or stops nfqws2 — that is upstream
# /etc/init.d/zapret2's job. So a 'start' here never raises the bypass service,
# paused or not. The watchdog self-skips its whole cycle while
# /tmp/zapret2-manager/paused exists (no recovery, no events).

USE_PROCD=1
START=99
STOP=10

PROG=/usr/libexec/zapret2-manager/watchdog.uc
UCODE=/usr/bin/ucode
BOOTSTRAP=/usr/libexec/zapret2-manager/z2m-root-bootstrap
HELPERD=/usr/libexec/zapret2-manager/z2m-helperd
DETECT=/usr/libexec/zapret2-manager/z2k-detect
DETECT_ADAPTER=/usr/libexec/zapret2-manager/z2k-detect.uc
DISCOVERED=/opt/zapret2/lists/discovered-domains.txt

start_service() {
	"$BOOTSTRAP" all || return $?
	"$UCODE" /usr/libexec/zapret2-manager/z2k-lifecycle-recovery.uc recover || return $?
	procd_open_instance helperd
	procd_set_param command "$HELPERD"
	procd_set_param respawn 60 5 5
	procd_set_param term_timeout 10
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param limits core=unlimited
	procd_close_instance

	# Discovery is deliberately a separate, named procd instance. The fixed
	# adapter is an importable module, not a raw script: it exports the
	# discovery contract alongside the RPC implementation. This shell only
	# accepts its bounded DNS-source result and never forwards user argv.
	discovery_eligible() {
		"$UCODE" -e "import * as detect from '$DETECT_ADAPTER'; let config = detect.z2k_detect_discovery_config_read(), authority = detect.z2k_detect_status(); if (!(config.ok === true && config.enabled === true && authority.ok === true && authority.coherent === true)) exit(1);" >/dev/null 2>&1
	}
	discovery_source() {
		"$UCODE" -e "import * as detect from '$DETECT_ADAPTER'; let config = detect.z2k_detect_discovery_config_read(), authority = detect.z2k_detect_status(); if (!(config.ok === true && config.enabled === true && authority.ok === true && authority.coherent === true)) exit(1); print(config.dnsSource);" 2>/dev/null
	}
	if [ ! -e /tmp/zapret2-manager/paused ] && discovery_eligible; then
		DNS_SOURCE="$(discovery_source)"
		case "$DNS_SOURCE" in
			auto|agh|dnsmasq|pkt)
				procd_open_instance z2k-detect
				if [ "$DNS_SOURCE" = auto ]; then
					procd_set_param command "$DETECT" run -publish "$DISCOVERED"
				else
					procd_set_param command "$DETECT" run -dns-source "$DNS_SOURCE" -publish "$DISCOVERED"
				fi
				procd_set_param respawn 60 5 5
				procd_set_param term_timeout 10
				procd_set_param stdout 1
				procd_set_param stderr 1
				procd_set_param limits core=unlimited
				procd_close_instance
				;;
		esac
	fi

	procd_open_instance watchdog
	procd_set_param command "$UCODE" "$PROG"
	# Respawn if the loop dies: threshold 60s, timeout 5, retry 5.
	procd_set_param respawn 60 5 5
	procd_set_param term_timeout 10
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param limits core=unlimited
	procd_close_instance
}

# Convenience: run one check cycle without starting the daemon.
# Used by tools/smoke.sh gate_06 to exercise the paused-skip path quickly.
extra_command "check" "Run one watchdog check cycle and exit"

check() {
	"$BOOTSTRAP" all || return $?
	"$UCODE" "$PROG" check
}
