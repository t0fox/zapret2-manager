#!/bin/sh /etc/rc.common
# init.d/zapret2-manager — native broker and watchdog daemons (branch 06).
#
# This init never starts or stops nfqws2 — that is upstream
# /etc/init.d/zapret2's job. So a 'start' here never raises the bypass service,
# paused or not. The watchdog self-skips its whole cycle while
# /tmp/zapret2-manager/paused exists (no recovery, no events).

USE_PROCD=1
START=99
STOP=10

PROG=/usr/libexec/zapret2-manager/watchdog.uc
UCODE=/usr/bin/ucode
BOOTSTRAP=/usr/libexec/zapret2-manager/z2m-root-bootstrap
HELPERD=/usr/libexec/zapret2-manager/z2m-helperd

start_service() {
	"$BOOTSTRAP" all || return $?
	"$UCODE" /usr/libexec/zapret2-manager/z2k-lifecycle-recovery.uc recover || return $?
	procd_open_instance helperd
	procd_set_param command "$HELPERD"
	procd_set_param respawn 60 5 5
	procd_set_param term_timeout 10
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param limits core=unlimited
	procd_close_instance

	procd_open_instance watchdog
	procd_set_param command "$UCODE" "$PROG"
	# Respawn if the loop dies: threshold 60s, timeout 5, retry 5.
	procd_set_param respawn 60 5 5
	procd_set_param term_timeout 10
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param limits core=unlimited
	procd_close_instance
}

# Convenience: run one check cycle without starting the daemon.
# Used by tools/smoke.sh gate_06 to exercise the paused-skip path quickly.
extra_command "check" "Run one watchdog check cycle and exit"

check() {
	"$BOOTSTRAP" all || return $?
	"$UCODE" "$PROG" check
}
