#!/bin/sh /etc/rc.common
# Manager-owned Telegram Proxy service lifecycle (provider-agnostic).
# Provider installs (Rust archive or Go APK) only replace /usr/bin/tg-ws-proxy;
# this init script, config.conf and secret.conf stay under manager ownership.

START=99
STOP=10

USE_PROCD=1

start_service() {
	local secret
	secret="$(cat /etc/tg-ws-proxy/secret.conf 2>/dev/null | sed -n 's/^TG_SECRET=//p')"
	[ -n "$secret" ] || return 1

	procd_open_instance
	procd_set_param command /usr/bin/tg-ws-proxy
	procd_set_param env TG_SECRET="$secret"
	procd_set_param file /etc/tg-ws-proxy/config.conf
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

stop_service() {
	return 0
}
