function active_dnsmasq() { let raw = run("ubus call service list '{\"name\":\"dnsmasq\"}'").out, data = null; try { data = json(raw); } catch (e) {} let candidates = []; for (let section in (data && data.dnsmasq ? data.dnsmasq.instances || {} : {})) { let inst = data.dnsmasq.instances[section]; if (!inst.running || !match('' + inst.pid, /^[0-9]+$/)) continue; let jail = int(inst.pid), pids = [jail], kids = split(trim(readfile('/proc/' + jail + '/task/' + jail + '/children') || ''), ' '); for (let i = 0; i < length(kids); i++) if (match(kids[i], /^[0-9]+$/)) push(pids, int(kids[i])); for (let j = 0; j < length(pids); j++) { let cmd = run("tr '\\000' ' ' < /proc/" + pids[j] + '/cmdline').out || '', c = match(cmd, /-C ([^ ]+)/); if (c && c[1] && index(cmd, 'dnsmasq') >= 0 && stat(c[1]) && readfile(c[1]) != null) push(candidates, { section: section, pid: pids[j], configPath: c[1] }); } } return length(candidates) == 1 ? candidates[0] : null; }
