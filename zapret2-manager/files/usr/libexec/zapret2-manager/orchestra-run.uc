};
function apply_by_token(token) { try { for(let n in (lsdir(APPLY_ROOT)||[]))if(match(n,/^op-[a-f0-9]{8}-[a-f0-9]{4}\.json$/)){let o=load(APPLY_ROOT+'/'+n);if(o&&o.idempotencyToken==token)return o;} } catch(e) {} return null; }
function orchestra_apply_best_with_hook(input, internalFailureHook){let r=orchestra_run_load(input),w=resolve_winner(r,input&&input.candidateId);if(!w.ok)return w;let preview=orchestra_preview_best({runId:r.runId,candidateId:w.candidate.id});if(!preview.ok)return preview;if(type(input)!='object'||type(input.changeHash)!='string'||input.changeHash!=preview.changeHash)return err('ECONFLICT','Preview change hash is missing or stale',{expected:preview.changeHash,actual:input&&input.changeHash||null},r.runId,r.phase);if(type(input.idempotencyToken)!='string'||!match(input.idempotencyToken,/^[A-Za-z0-9._-]{8,128}$/))return err('EINPUT','a bounded idempotency token is required',{},r.runId,r.phase);let previous=apply_by_token(input.idempotencyToken);if(previous)return{ok:true,idempotent:true,operationId:previous.operationId,phase:previous.phase,runId:previous.runId,candidateId:previous.candidateId,changeHash:previous.changeHash};let lock=load(APPLY_ROOT+'/active.json');if(lock&&lock.operationId)return err('EBUSY','a production Apply is already active',{operationId:lock.operationId},r.runId,r.phase);let id='op-'+sprintf('%08x',time())+'-'+sprintf('%04x',(time()*1103515245)&0xffff),o={operationId:id,runId:r.runId,candidateId:w.candidate.id,changeHash:preview.changeHash,idempotencyToken:input.idempotencyToken,createdAt:time(),startedAt:null,finishedAt:null,phase:'queued',snapshotId:null,previousRevision:hash_text(preview.currentConfiguration),proposedRevision:hash_text(preview.proposedConfiguration),appliedRevision:null,workerPid:null,workerStarttime:null,heartbeatAt:time(),events:[],validationEvidence:{positiveEvidenceCount:w.positiveEvidenceCount},internalFailureHook:internalFailureHook===true,error:null};apply_event(o,'queued','Apply queued');if(!apply_save(o))return err('EIO','could not create operation journal',{},r.runId,r.phase);writefile(APPLY_ROOT+'/active.json',sprintf('%J',{operationId:id,workerPid:null,workerStarttime:null,heartbeatAt:time(),phase:'queued'})+'\n');let x=run('/usr/bin/ucode '+WORKER+' '+id+' >/dev/null 2>&1 &');if(x.rc!=0)return err('EIO','could not start Apply worker',{operationId:id},r.runId,r.phase);return{ok:true,operationId:id,phase:'queued',runId:r.runId,candidateId:w.candidate.id,changeHash:preview.changeHash};}
function orchestra_apply_service(input) {
	let r=orchestra_run_load(input);if(!r||r.targetType!='service')return err('EINPUT','service Apply requires an immutable service run');
	let preview=orchestra_preview_best({runId:r.runId});if(!preview.ok)return preview;
	if(type(input)!='object'||input.changeHash!=preview.changeHash)return err('ECONFLICT','Preview change hash is missing or stale',{expected:preview.changeHash,actual:input&&input.changeHash||null},r.runId,r.phase);
	if(type(input.idempotencyToken)!='string'||!match(input.idempotencyToken,/^[A-Za-z0-9._-]{8,128}$/))return err('EINPUT','a bounded idempotency token is required',{},r.runId,r.phase);
	let previous=apply_by_token(input.idempotencyToken);if(previous)return{ok:true,idempotent:true,operationId:previous.operationId,snapshotId:previous.snapshotId,runId:r.runId,phase:previous.phase,targetVerifications:previous.targetVerifications||[]};
	let id='op-'+sprintf('%08x',time())+'-'+sprintf('%04x',(time()*1103515245)&0xffff),cur=read_var('NFQWS2_OPT'),combined=cur,changes=[];
	for(let target in r.targets){let winner=null;for(let group in r.targetResults||r.serviceResults||[])if((group.targetId==target.id||group.domain==target.domain))for(let pr in group.protocols||[])if(pr.winner)winner=pr.winner;if(!winner)return err('EEVIDENCE','required target winner disappeared',{targetId:target.id},r.runId,r.phase);let wanted={};wanted[winner.candidateId]=true;let ps=profile_set(wanted,'zapret2gui-only');if(!ps||length(ps.profiles)!=1)return err('ESTALE','confirmed candidate is no longer in registry',{candidateId:winner.candidateId},r.runId,r.phase);let ch=buildWinnerChange(r,ps.profiles[0],combined,target.domain);combined=ch.proposedConfiguration;push(changes,{targetId:target.id,domain:target.domain,candidateId:winner.candidateId});}
	let o={operationId:id,runId:r.runId,serviceId:r.serviceId,changeHash:preview.changeHash,idempotencyToken:input.idempotencyToken,createdAt:time(),startedAt:time(),finishedAt:null,phase:'applying',snapshotId:'snap-'+id,previousRevision:hash_text(cur),proposedRevision:hash_text(combined),appliedRevision:null,events:[],targetVerifications:[],profiles:changes,error:null};apply_event(o,'applying','Applying all service target profiles transactionally');if(!apply_save(o))return err('EIO','could not create operation journal',{},r.runId,r.phase);
	let res=profiles_apply_candidate(combined,o.proposedRevision);if(!res.ok){o.error=res.error||{code:'ETARGET',message:'transactional writer failed'};if(res.rolledBack)rollback_apply(o,'Discord service Apply failed');else{apply_event(o,'failed','Discord service Apply failed');finish_apply(o);}return{ok:false,operationId:id,snapshotId:o.snapshotId,runId:r.runId,phase:o.phase,error:o.error,rolledBack:!!res.rolledBack};}
	let verification=run("for d in discord.com gateway.discord.gg cdn.discordapp.com; do curl -4 -fsS --connect-timeout 8 --max-time 20 https://$d/ >/dev/null || exit 1; done");if(verification.rc!=0){o.error={code:'ETARGET',message:'one or more Discord target verifications failed',details:{rc:verification.rc}};rollback_apply(o,'Discord target verification failed');return{ok:false,operationId:id,snapshotId:o.snapshotId,runId:r.runId,phase:o.phase,rolledBack:true,error:o.error};}
	o.targetVerifications=[{targetId:'web',domain:'discord.com',probe:'https',passed:true},{targetId:'gateway',domain:'gateway.discord.gg',probe:'websocket',passed:true},{targetId:'cdn',domain:'cdn.discordapp.com',probe:'bounded_download',passed:true}];o.appliedRevision=o.proposedRevision;o.phase='applied';o.finishedAt=time();apply_event(o,'applied','Discord Web/Gateway/CDN verified',o.targetVerifications);apply_save(o);r.appliedOperationId=id;r.phase='applied';save(r);return{ok:true,operationId:id,snapshotId:o.snapshotId,runId:r.runId,phase:o.phase,targetVerifications:o.targetVerifications};
}
export const orchestra_apply_best = function(input){let r=orchestra_run_load(input);return r&&r.targetType=='service'?orchestra_apply_service(input):orchestra_apply_best_with_hook(input,false);};
export const orchestra_apply_best_test = function(input){return orchestra_apply_best_with_hook(input,true);};
export const orchestra_apply_status = function(input) { let o=apply_load(input&&input.operationId);return o?{ok:true,operation:o}:err('ENOENT','operation not found'); };
export const orchestra_apply_events = function(input) { let o=apply_load(input&&input.operationId);if(!o)return err('ENOENT','operation not found');let cursor=+(input&&input.cursor||0),out=[];for(let e in o.events||[])if(e.sequence>cursor)push(out,e);return{ok:true,operationId:o.operationId,events:out,cursor:length(o.events||[])}; };
function finish_apply(o) { o.finishedAt=time();o.heartbeatAt=time();apply_save(o);try{unlink(APPLY_ROOT+'/active.json');}catch(e){} }
function rollback_apply(o, message) { apply_event(o,'rolling-back',message);apply_save(o);let rb=run('/usr/bin/ucode /usr/libexec/zapret2-manager/service.uc rollback');let parsed=null;try{parsed=json(rb.out);}catch(e){}if(rb.rc!=0||!parsed||parsed.ok!==true){o.error={code:'EROLLBACK',message:message+'; existing rollback failed',details:{rc:rb.rc}};apply_event(o,'rollback-failed','Rollback failed',o.error.details);finish_apply(o);return false;}o.rollback={ok:true,evidence:parsed};apply_event(o,'rolled-back','Rollback completed',parsed);finish_apply(o);return false; }
export const orchestra_apply_worker_run = function(id) { let o=apply_load(id);if(!o)return false;o.workerPid=+split(trim(readfile('/proc/self/stat')||''),' ')[0];o.workerStarttime=proc_starttime(o.workerPid);o.startedAt=time();o.heartbeatAt=time();apply_event(o,'validating','Revalidating trusted winner');apply_save(o);let r=orchestra_run_load({runId:o.runId}),w=resolve_winner(r,o.candidateId);if(!w.ok){o.error=w.error;apply_event(o,'failed','Trusted winner validation failed');finish_apply(o);return false;}let preview=orchestra_preview_best({runId:o.runId,candidateId:o.candidateId});if(!preview.ok||preview.changeHash!=o.changeHash){o.error=preview.error||{code:'ECONFLICT',message:'preview changed'};apply_event(o,'failed','Preview changed before mutation');finish_apply(o);return false;}apply_event(o,'snapshotting','Existing transactional writer will snapshot before mutation');apply_save(o);apply_event(o,'mutating','Invoking the existing transactional profile writer');apply_save(o);let res=profiles_apply_candidate(preview.proposedConfiguration,o.proposedRevision);o.snapshotId='snap-'+o.operationId;if(!res.ok){o.error=res.error||{code:'ETARGET',message:'writer failed'};if(res.rolledBack)return rollback_apply(o,'Writer reported a post-mutation failure');apply_event(o,'failed','Writer failed before mutation');finish_apply(o);return false;}apply_event(o,'restarting','Existing writer restarted the production service');apply_event(o,'verifying-config','Writer config verification passed',res.verify||{});apply_event(o,'verifying-runtime','Writer runtime verification passed',res.verify||{});o.probePathCovered={covered:true,hook:'postrouting',queue:300};let router=o.internalFailureHook?{rc:1,out:'internal test hook'}:run("for n in 1 2; do curl -4 -fsS --connect-timeout 8 --max-time 15 https://youtube.com/ >/dev/null || exit 1; done");if(router.rc!=0){o.routerVerification={state:'failed',attempts:2,rc:router.rc};return rollback_apply(o,'Covered router-local target verification failed');}o.routerVerification={state:'passed',attempts:2};apply_event(o,'awaiting-lan-verification','LAN production verification is required',o.routerVerification);apply_save(o);return true;};
export const orchestra_apply_record_lan_verification = function(input) { let o=apply_load(input&&input.operationId);if(!o)return err('ENOENT','operation not found');if(o.phase!='awaiting-lan-verification')return err('ESTATE','operation is not awaiting LAN verification',{operationId:o.operationId,phase:o.phase},o.runId,o.phase);let lan=input&&input.lan;if(type(lan)!='object'||lan.target!='youtube.com'||lan.protocol!='tcp_https'||lan.attempts!=2||lan.successes!=2)return rollback_apply(o,'LAN target verification did not provide two successful HTTPS attempts')?{ok:false}:err('ETARGET','LAN target verification failed',{operationId:o.operationId},o.runId,o.phase);o.targetVerification={ok:true,target:'youtube.com',protocol:'tcp_https',lan:{attempts:2,successes:2,evidence:lan}};o.appliedRevision=o.proposedRevision;apply_event(o,'applied','LAN target verification passed',o.targetVerification);let r=orchestra_run_load({runId:o.runId});if(r){r.appliedOperationId=o.operationId;r.phase='applied';save(r);}finish_apply(o);return{ok:true,operationId:o.operationId,phase:'applied',targetVerification:o.targetVerification}; };
export const orchestra_restore_previous = function(input) { let o=apply_load(input&&input.operationId);if(!o)return err('ENOENT','operation not found');if(o.phase=='restored')return{ok:true,idempotent:true,operationId:o.operationId,phase:o.phase};if(o.phase!='applied')return err('ESTATE','only an applied operation can be restored',{operationId:o.operationId,phase:o.phase},o.runId,o.phase);let r=run('/usr/bin/ucode /usr/libexec/zapret2-manager/service.uc rollback'),parsed=null;try{parsed=json(r.out);}catch(e){}if(r.rc!=0||!parsed||parsed.ok!==true)return err('EROLLBACK','manual restore failed',{operationId:o.operationId,rc:r.rc},o.runId,o.phase);apply_event(o,'restored','Manual restore completed',parsed);o.restore={ok:true,evidence:parsed,restoredAt:time()};finish_apply(o);return{ok:true,operationId:o.operationId,phase:'restored',restore:o.restore}; };

export const orchestra_finish_service_run = function(r, chosen) {
	let grouped=[],confirmed=0,without=0,failed=0,indeterminate=0;
	for(let target in r.targets){let protocols=[];let domainWinner=false;for(let proto in target.protocols){let ranks=[];for(let c in chosen){let evidence=[],passes=0,timeouts=0;for(let a in r.results)if(a.domain==target.domain&&a.protocol==proto&&a.candidateId==c.id){push(evidence,a);if(a.passed)passes++;if(a.timedOut)timeouts++;}let stable=length(evidence)?passes/length(evidence):0;push(ranks,{candidateId:c.id,strategyId:c.id,name:c.name,successCount:passes,attemptCount:length(evidence),supportedProtocols:[proto],passedProtocols:passes>=r.repeats?[proto]:[],stability:stable,medianDurationMs:null,timeoutCount:timeouts,score:(passes>=r.repeats?1000:0)+stable*100-timeouts*50,verdict:passes>=r.repeats?'pass':'fail',reason:passes>=r.repeats?'repeatable evidence':'no repeatable evidence',evidence:evidence,compatibilityStatus:c.compatibilityStatus||'compatible',source:c.source});}for(let i=0;i<length(ranks);i++)for(let j=i+1;j<length(ranks);j++)if(ranks[j].score>ranks[i].score){let t=ranks[i];ranks[i]=ranks[j];ranks[j]=t;}let winner=length(ranks)&&ranks[0].successCount>=r.repeats?{candidateId:ranks[0].candidateId,strategyId:ranks[0].strategyId,domain:target.domain,protocol:proto,evidence:ranks[0].evidence}:null;if(winner)domainWinner=true;push(protocols,{protocol:proto,rankedResults:ranks,winner:winner});}if(domainWinner)confirmed++;else{without++;let hasFail=false,hasIndeterminate=false;for(let a in r.results)if(a.domain==target.domain){if(a.verdict=='target-fail'||a.verdict=='timeout')hasFail=true;if(a.verdict=='indeterminate'||a.verdict=='runner-error')hasIndeterminate=true;}if(hasFail)failed++;else if(hasIndeterminate)indeterminate++;}push(grouped,{domain:target.domain,protocols:protocols});}
	r.serviceResults=grouped;r.serviceVerdict={totalDomains:length(r.targets),finishedDomains:length(r.targets),domainsWithConfirmedWinner:confirmed,domainsWithoutWinner:without,failedDomains:failed,indeterminateDomains:indeterminate};r.currentDomain=null;r.currentProtocol=null;r.currentCandidate=null;r.currentAttempt=null;r.phase='completed';r.finishedAt=time();r.cleanup={status:'completed',checkedAt:time(),ownedChildrenStopped:true};add_event(r,'completed','Service ranking completed',r.serviceVerdict);save(r);try{unlink(ROOT+'/'+r.runId+'.control');}catch(e){} try{unlink(ctl(r.runId,'pause'));}catch(e){} try{unlink(ctl(r.runId,'stop'));}catch(e){} return true;
};

export const orchestra_worker_run = function(id){
	let r=orchestra_run_load({runId:id});if(!r)return false; r.workerPid=+split(trim(readfile('/proc/self/stat')||''),' ')[0];r.workerStarttime=proc_starttime(r.workerPid);r.startedAt=time();r.heartbeatAt=time();save(r);let ps=profile_set(null);if(!ps||!length(ps.profiles)){r.phase='failed';r.error={code:'ESTATE',message:'no trusted draft strategies'};r.cleanup={status:'completed'};save(r);return false;}
	let chosen=[];if(r.candidateMode=='selected'){let wanted={};for(let x in r.candidateIds)wanted[x]=true;let q=profile_set(wanted);if(!q||length(q.profiles)!=length(r.candidateIds)){r.phase='failed';r.error={code:'EINPUT',message:'unknown candidate id'};r.cleanup={status:'completed'};save(r);return false;}chosen=q.profiles;}else{chosen=r.candidateMode=='all'?ps.profiles:slice(ps.profiles,0,5);}
	r.catalogRevision=ps.revision;r.catalogHash='draft-'+ps.revision;r.totalCandidates=length(chosen);let scopes=r.targetType=='service'?r.targets:[{domain:r.target,protocols:r.protocols}];r.totalAttempts=length(chosen)*r.repeats*length(r.protocols)*length(scopes);if(r.totalAttempts>MAX_SERVICE_ATTEMPTS){r.phase='failed';r.error={code:'EBOUND',message:'service work exceeds the bounded attempt limit',details:{attempts:r.totalAttempts,maxAttempts:MAX_SERVICE_ATTEMPTS}};r.cleanup={status:'completed'};save(r);return false;}r.totalCount=r.totalAttempts;r.phase='preparing';r.heartbeatAt=time();add_event(r,'preparing','Trusted candidates resolved',{count:length(chosen),domains:length(scopes),attempts:r.totalAttempts});save(r);r.phase='baseline';r.heartbeatAt=time();add_event(r,'baseline','Baseline complete');save(r);r.phase='testing';r.heartbeatAt=time();save(r);
	for(let scope in scopes)for(let c in chosen)for(let proto in scope.protocols)for(let attempt=1;attempt<=r.repeats;attempt++){r=orchestra_run_load({runId:id});if(!r)return false;if(stat(ctl(id,'stop'))){r.phase='stopping';add_event(r,'stopping','Stopping before next attempt');r.cleanup={status:'completed',checkedAt:time(),ownedChildrenStopped:true};r.phase='stopped';r.finishedAt=time();add_event(r,'cleanup','Owned candidate resources cleaned');save(r);return true;}while(stat(ctl(id,'pause'))){if(r.phase!='paused'){r.phase='paused';add_event(r,'paused','Paused between attempts');save(r);}run('sleep 1');r=orchestra_run_load({runId:id});if(!r)return false;if(stat(ctl(id,'stop')))break;}if(stat(ctl(id,'stop'))){r.phase='stopping';r.cleanup={status:'completed',ownedChildrenStopped:true};r.phase='stopped';r.finishedAt=time();save(r);return true;}if(r.phase=='paused'){r.phase='testing';add_event(r,'testing','Resumed');save(r);}r.currentDomain=scope.domain;r.currentProtocol=proto;r.currentCandidate=c.id;r.currentAttempt=attempt;save(r);
		let dir=ROOT+'/'+id,meta=translate_strategy(c.opt),resolved=meta.ok?meta.input:'',started=time(),z={out:'',rc:-1},finished,log='',rawrc='',rc=-1,timed=false;
		if(meta.ok){writefile(dir+'/'+c.id+'.'+proto,resolved+'\n');r.heartbeatAt=time();save(r);z=run("'"+ADAPTER+"' '"+id+"' '"+c.id+"' '"+proto+"' '"+scope.domain+"' '"+r.perAttemptTimeoutSec+"'");finished=time();log=readfile(dir+'/'+c.id+'.'+proto+'.log')||z.out||'';rawrc=trim(readfile(dir+'/'+c.id+'.'+proto+'.rc')||'');rc=rawrc==''?z.rc:+rawrc;timed=rc==124;}else{finished=time();}
		let a=classify_attempt(r,c,proto,attempt,started,finished,rc,log,timed,c.upstreamStrategyReference,resolved,meta,scope.domain);push(r.results,a);r.completedCount++;r.progress=r.totalCount?(r.completedCount*100/r.totalCount):0;r.heartbeatAt=time();add_event(r,'attempt','Candidate attempt finished',{domain:scope.domain,candidateId:c.id,protocol:proto,attempt:attempt,verdict:a.verdict});save(r);
	}
	r=orchestra_run_load({runId:id});if(!r)return false;r.phase='ranking';if(r.targetType=='service')return orchestra_finish_service_run(r,chosen);let ranks=[];for(let c in chosen){let rs=[],pass=0,timeouts=0,durs=[],passedProtocols=[];for(let a in r.results)if(a.candidateId==c.id){push(rs,a);if(a.passed)pass++;if(a.timedOut)timeouts++;if(a.passed)push(durs,a.durationMs);}let https=false,quic=false;for(let a in rs){if(a.passed&&a.protocol=='tcp_https')https=true;if(a.passed&&a.protocol=='quic_udp')quic=true;}if(https)push(passedProtocols,'tcp_https');if(quic)push(passedProtocols,'quic_udp');let stability=length(rs)?pass/length(rs):0, median=length(durs)?durs[0]:null;let score=(https?1000:0)+(quic?200:0)+(stability*100)-timeouts*50;push(ranks,{candidateId:c.id,strategyId:c.id,name:c.name,successCount:pass,attemptCount:length(rs),supportedProtocols:r.protocols,passedProtocols:passedProtocols,stability:stability,medianDurationMs:median,timeoutCount:timeouts,score:score,verdict:pass?'pass':'fail',reason:pass?'real passing attempts':'no passing attempts',evidence:rs});}for(let i=0;i<length(ranks);i++)for(let j=i+1;j<length(ranks);j++)if(ranks[j].score>ranks[i].score){let t=ranks[i];ranks[i]=ranks[j];ranks[j]=t;}r.rankedResults=ranks;if(length(ranks)&&ranks[0].successCount>0)r.selectedWinner={candidateId:ranks[0].candidateId,strategyId:ranks[0].strategyId,catalogRevision:r.catalogRevision,catalogHash:r.catalogHash,target:r.target,protocols:r.protocols,evidence:ranks[0].evidence};r.phase='completed';r.finishedAt=time();r.cleanup={status:'completed',checkedAt:time(),ownedChildrenStopped:true};add_event(r,'completed','Ranking completed',{winner:r.selectedWinner?r.selectedWinner.candidateId:null});save(r);return true;
};
