		if(x.retryOfRunId){let previous=load(path(x.retryOfRunId));if(!previous||previous.validity!='invalid')return err('ESTATE','retryOfRunId must reference an invalidated run');if(previous.serviceId!=x.target)return err('EINPUT','retry lineage service mismatch');}
