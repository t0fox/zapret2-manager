function apply_path(id) { return APPLY_ROOT+'/'+id+'.json'; }
function apply_save(o) { try { mkdir('/var/lib/zapret2-manager'); mkdir(APPLY_ROOT); } catch(e) {} let p=apply_path(o.operationId),t=p+'.tmp.'+time();writefile(t,sprintf('%J',o)+'\n');return run("mv -f '"+t+"' '"+p+"'").rc==0; }
function apply_load(id) { return type(id)=='string' && match(id,/^op-[a-f0-9]{8}-[a-f0-9]{4}$/) ? load(apply_path(id)) : null; }
function apply_event(o,phase,message,details) { o.phase=phase;o.updatedAt=time();if(!o.events)o.events=[];push(o.events,{sequence:length(o.events)+1,timestamp:time(),phase:phase,message:message,details:details||{}}); }
