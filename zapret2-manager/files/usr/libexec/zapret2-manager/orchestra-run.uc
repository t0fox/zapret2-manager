	if(protocol!='tcp_https')return err('EUNSUPPORTED','Apply supports only tcp_https', {protocol:protocol},r.runId,r.phase);let id=input&&input.candidateId||winner&&winner.candidateId;if(!winner||id!=winner.candidateId)return err('EINPUT','candidateId is not the confirmed winner for this domain and protocol',{},r.runId,r.phase);let wanted={};wanted[id]=true;let ps=profile_set(wanted,'all');if(!ps||length(ps.profiles)!=1)return err('ESTALE','trusted winner is no longer in the catalog',{},r.runId,r.phase);let c=ps.profiles[0];if(c.protocol!='tcp_https')return err('EUNSUPPORTED','Apply supports only tcp_https',{protocol:c.protocol},r.runId,r.phase);let evidence=[];for(let a in r.results||[])if(a.domain==domain&&a.candidateId==id&&a.protocol=='tcp_https'&&a.verdict=='pass'&&a.positiveEvidence)push(evidence,a);if(length(evidence)<2)return err('EEVIDENCE','two real positive HTTPS attempts are required',{positiveEvidenceCount:length(evidence)},r.runId,r.phase);let normalized=translate_strategy(c.opt),positive=evidence[0];if(!normalized.ok||normalized.hash!=positive.sanitizedParameterHash)return err('ESTALE','candidate hash changed since the completed run',{expected:positive.sanitizedParameterHash,actual:normalized.ok?normalized.hash:null},r.runId,r.phase);for(let b in c.requiredBlobs||[])if(!stat('/opt/zapret2/lua/'+b))return err('ETARGET','required Lua blob is unavailable',{blob:b},r.runId,r.phase);return {ok:true,run:r,candidate:c,targetDomain:domain,protocol:protocol,evidence:positive,positiveEvidenceCount:length(evidence)};
