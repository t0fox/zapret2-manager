diff --git a/nfq2/protocol.h b/nfq2/protocol.h
index 9c3792d..79b4a14 100644
--- a/nfq2/protocol.h
+++ b/nfq2/protocol.h
@@ -141,6 +141,22 @@ struct fake_tls_mod
 #define FAKE_TLS_MOD_SNI		0x04
