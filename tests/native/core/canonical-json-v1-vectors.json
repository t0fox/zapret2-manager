{
  "format": "z2m-canonical-json-v1-test-corpus",
  "canonicalization": "z2m-canonical-json-v1",
  "limits": {
    "canonicalBytes": 521028,
    "depth": 64,
    "containers": 1024,
    "members": 1024,
    "nodes": 65536,
    "keyBytes": 4096,
    "requestBytes": 4194304
  },
  "accept": [
    {"id":"null","category":"scalars","input":"null","expected":"null","rationale":"null is an allowed value"},
    {"id":"true","category":"scalars","input":"true","expected":"true","rationale":"true is an allowed value"},
    {"id":"false","category":"scalars","input":"false","expected":"false","rationale":"false is an allowed value"},
    {"id":"zero","category":"numbers","input":"0","expected":"0","rationale":"zero is a signed 64-bit integer"},
    {"id":"negative-zero","category":"numbers","input":"-0","expected":"0","rationale":"negative zero is normalized to integer zero"},
    {"id":"positive-one","category":"numbers","input":"1","expected":"1","rationale":"shortest signed integer rendering"},
    {"id":"negative-one","category":"numbers","input":"-1","expected":"-1","rationale":"shortest signed integer rendering"},
    {"id":"int64-min","category":"numbers","input":"-9223372036854775808","expected":"-9223372036854775808","rationale":"signed 64-bit lower boundary"},
    {"id":"int64-max","category":"numbers","input":"9223372036854775807","expected":"9223372036854775807","rationale":"signed 64-bit upper boundary"},
    {"id":"empty-string","category":"strings","input":"\"\"","expected":"\"\"","rationale":"empty strings are allowed"},
    {"id":"ascii-string","category":"strings","input":"\"hello\"","expected":"\"hello\"","rationale":"ordinary ASCII is raw UTF-8"},
    {"id":"quote-string","category":"strings","input":"\"quote\\\"\"","expected":"\"quote\\\"\"","rationale":"quotation mark uses the short required escape"},
    {"id":"backslash-string","category":"strings","input":"\"slash\\\\\"","expected":"\"slash\\\\\"","rationale":"reverse solidus uses the short required escape"},
    {"id":"solidus-string","category":"strings","input":"\"a/b\"","expected":"\"a/b\"","rationale":"solidus is emitted unescaped"},
    {"id":"short-control-escapes","category":"strings","input":"\"\\b\\t\\n\\f\\r\"","expected":"\"\\b\\t\\n\\f\\r\"","rationale":"the five required short control escapes"},
    {"id":"control-hex-escapes","category":"strings","input":"\"\\u0000\\u0001\\u001f\"","expected":"\"\\u0000\\u0001\\u001f\"","rationale":"other C0 controls use lowercase hex"},
    {"id":"ascii-del","category":"strings","input":"\"\\u007f\"","expected":"\"\u007f\"","rationale":"U+007F is emitted as raw UTF-8"},
    {"id":"unicode-line-separators","category":"strings","input":"\"\\u2028\\u2029\"","expected":"\"\u2028\u2029\"","rationale":"U+2028 and U+2029 are raw UTF-8"},
    {"id":"utf8-bmp","category":"strings","input":"\"\\u00e9\"","expected":"\"\u00e9\"","rationale":"valid BMP scalar is emitted as raw UTF-8"},
    {"id":"utf8-supplementary","category":"strings","input":"\"\\ud83d\\ude00\"","expected":"\"\ud83d\ude00\"","rationale":"valid surrogate pair becomes one raw supplementary scalar"},
    {"id":"escaped-equivalent","category":"strings","input":"\"\\u0061\"","expected":"\"a\"","rationale":"escape spelling is not preserved"},
    {"id":"whitespace-document","category":"framing","input":" \n { \"b\" : 2 , \"a\" : 1 } \t\r\n","expected":"{\"a\":1,\"b\":2}","rationale":"insignificant whitespace is removed"},
    {"id":"empty-object","category":"objects","input":"{}","expected":"{}","rationale":"empty object is an allowed container"},
    {"id":"empty-array","category":"arrays","input":"[]","expected":"[]","rationale":"empty array is an allowed container"},
    {"id":"sorted-object","category":"objects","input":"{\"a\":1,\"b\":2}","expected":"{\"a\":1,\"b\":2}","rationale":"already sorted keys remain sorted"},
    {"id":"reverse-object","category":"objects","input":"{\"b\":2,\"a\":1}","expected":"{\"a\":1,\"b\":2}","rationale":"keys sort independent of insertion order"},
    {"id":"prefix-keys","category":"objects","input":"{\"aa\":2,\"a\":1}","expected":"{\"a\":1,\"aa\":2}","rationale":"shorter UTF-8 key sorts first when it is a prefix"},
    {"id":"ascii-byte-order","category":"objects","input":"{\"a\":1,\"Z\":2}","expected":"{\"Z\":2,\"a\":1}","rationale":"unsigned byte order is case-sensitive"},
    {"id":"recursive-order","category":"objects","input":"{\"z\":{\"y\":2,\"x\":1},\"a\":0}","expected":"{\"a\":0,\"z\":{\"x\":1,\"y\":2}}","rationale":"sorting is recursive"},
    {"id":"array-order","category":"arrays","input":"{\"a\":[3,2,1]}","expected":"{\"a\":[3,2,1]}","rationale":"array element order is preserved"},
    {"id":"mixed-array","category":"arrays","input":"[null,false,0,\"x\",[],{}]","expected":"[null,false,0,\"x\",[],{}]","rationale":"arrays retain mixed allowed value types"},
    {"id":"nested-arrays","category":"arrays","input":"[[3,[2]],1]","expected":"[[3,[2]],1]","rationale":"nested arrays are never sorted"},
    {"id":"composed-decomposed","category":"unicode","input":"{\"\\u00e9\":1,\"e\\u0301\":2}","expected":"{\"e\u0301\":2,\"\u00e9\":1}","rationale":"no Unicode normalization; compare decoded UTF-8 bytes"},
    {"id":"utf8-vs-utf16-order","category":"ordering","input":"{\"\\ud800\\udc00\":1,\"\\ue000\":2}","expected":"{\"\ue000\":2,\"\ud800\udc00\":1}","rationale":"UTF-8 byte order differs from UTF-16 code-unit order"},
    {"id":"escaped-key-order","category":"objects","input":"{\"\\u0062\":2,\"a\":1}","expected":"{\"a\":1,\"b\":2}","rationale":"keys are ordered after escape decoding"},
    {"id":"zero-key","category":"objects","input":"{\"0\":0}","expected":"{\"0\":0}","rationale":"numeric-looking keys remain strings"},
    {"id":"depth-boundary","category":"boundaries","generator":{"kind":"nested_object","depth":64},"expectedGenerator":{"kind":"reference"},"rationale":"root depth 1 and exact depth 64 are allowed"},
    {"id":"container-boundary","category":"boundaries","generator":{"kind":"container_count","count":1024},"expectedGenerator":{"kind":"reference"},"rationale":"exact container limit is allowed"},
    {"id":"member-boundary","category":"boundaries","generator":{"kind":"object_member_count","count":1024},"expectedGenerator":{"kind":"reference"},"rationale":"exact total object member limit is allowed"},
    {"id":"node-boundary","category":"boundaries","generator":{"kind":"node_count","count":65536},"expectedGenerator":{"kind":"reference"},"rationale":"root plus 65535 array elements is exact node limit"},
    {"id":"key-boundary","category":"boundaries","generator":{"kind":"key_bytes","bytes":4096},"expectedGenerator":{"kind":"reference"},"rationale":"exact decoded object-key byte limit is allowed"},
    {"id":"output-boundary","category":"boundaries","generator":{"kind":"canonical_output_bytes","bytes":521028},"expectedGenerator":{"kind":"reference"},"rationale":"exact canonical byte limit is allowed"}
  ],
  "contractGaps": [
    {"id":"escaped-nul-key-policy","input":"{\"\\u0000\":1}","canonicalImplication":"Unicode scalar key can be encoded as \\u0000","protocolImplication":"embeddedNulObjectKeys is reject_schema","decision":"resolve before production semantic construction"}
  ],
  "reject": [
    {"id":"leading-zero","category":"numbers","input":"01","class":"malformed_lexical_json","rationale":"leading zeroes are not JSON integer grammar"},
    {"id":"plus-sign","category":"numbers","input":"+1","class":"malformed_lexical_json","rationale":"leading plus is forbidden"},
    {"id":"decimal","category":"numbers","input":"1.0","class":"forbidden_number","rationale":"floating-point lexical form is outside the value domain"},
    {"id":"exponent","category":"numbers","input":"1e0","class":"forbidden_number","rationale":"exponent notation is outside the integer token grammar"},
    {"id":"negative-decimal-zero","category":"numbers","input":"-0.0","class":"forbidden_number","rationale":"negative floating-point zero is rejected"},
    {"id":"int64-below","category":"numbers","input":"-9223372036854775809","class":"integer_overflow","rationale":"below signed 64-bit minimum"},
    {"id":"int64-above","category":"numbers","input":"9223372036854775808","class":"integer_overflow","rationale":"above signed 64-bit maximum"},
    {"id":"long-decimal","category":"numbers","input":"999999999999999999999999999999999999999999999999999999999999999999","class":"integer_overflow","rationale":"large integer token is outside signed 64-bit range"},
    {"id":"duplicate-literal","category":"duplicates","input":"{\"a\":1,\"a\":2}","class":"duplicate_key","rationale":"literal duplicate keys are rejected"},
    {"id":"duplicate-decoded-equivalent","category":"duplicates","input":"{\"a\":1,\"\\u0061\":2}","class":"duplicate_key","rationale":"decoded Unicode scalar sequences define key identity"},
    {"id":"duplicate-nested","category":"duplicates","input":"{\"outer\":{\"a\":1,\"\\u0061\":2}}","class":"duplicate_key","rationale":"duplicate detection is recursive"},
    {"id":"lone-high-surrogate","category":"unicode","input":"\"\\ud800\"","class":"invalid_unicode","rationale":"lone high surrogate is not a Unicode scalar"},
    {"id":"lone-low-surrogate","category":"unicode","input":"\"\\udc00\"","class":"invalid_unicode","rationale":"lone low surrogate is not a Unicode scalar"},
    {"id":"malformed-surrogate-pair","category":"unicode","input":"\"\\ud800x\"","class":"invalid_unicode","rationale":"high surrogate must be followed by low surrogate"},
    {"id":"reversed-surrogate-pair","category":"unicode","input":"\"\\udc00\\ud800\"","class":"invalid_unicode","rationale":"low surrogate cannot start a pair"},
    {"id":"bom","category":"framing","input":"\ufeff0","class":"malformed_lexical_json","rationale":"canonical document has no BOM and JSON value framing rejects it"},
    {"id":"trailing-garbage","category":"framing","input":"0x","class":"trailing_data","rationale":"one complete JSON document is required"},
    {"id":"multiple-documents","category":"framing","input":"0 1","class":"trailing_data","rationale":"multiple JSON documents are rejected"},
    {"id":"trailing-comma-array","category":"framing","input":"[1,]","class":"malformed_lexical_json","rationale":"JSON arrays do not allow trailing commas"},
    {"id":"trailing-comma-object","category":"framing","input":"{\"a\":1,}","class":"malformed_lexical_json","rationale":"JSON objects do not allow trailing commas"},
    {"id":"depth-over","category":"boundaries","generator":{"kind":"nested_object","depth":65},"class":"depth_exceeded","rationale":"depth 65 exceeds frozen depth 64"},
    {"id":"container-over","category":"boundaries","generator":{"kind":"container_count","count":1025},"class":"count_exceeded","rationale":"container 1025 exceeds frozen container limit"},
    {"id":"member-over","category":"boundaries","generator":{"kind":"object_member_count","count":1025},"class":"count_exceeded","rationale":"member 1025 exceeds frozen member limit"},
    {"id":"node-over","category":"boundaries","generator":{"kind":"node_count","count":65537},"class":"count_exceeded","rationale":"node 65537 exceeds frozen node limit"},
    {"id":"key-over","category":"boundaries","generator":{"kind":"key_bytes","bytes":4097},"class":"key_too_large","rationale":"decoded key byte 4097 exceeds frozen key limit"},
    {"id":"output-over","category":"boundaries","generator":{"kind":"canonical_output_bytes","bytes":521029},"class":"output_too_large","rationale":"canonical output byte 521029 exceeds frozen output limit"},
    {"id":"raw-nul","category":"unicode","inputBytesHex":"220022","class":"invalid_utf8","rationale":"raw embedded NUL is rejected on the request byte stream"},
    {"id":"invalid-utf8","category":"unicode","inputBytesHex":"22ff22","class":"invalid_utf8","rationale":"malformed UTF-8 is rejected"}
  ]
}
