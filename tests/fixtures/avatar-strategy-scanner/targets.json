      "expected": {
        "profileKey": "youtube",
        "primaryHost": "youtube.com",
        "testHosts": [
          "www.youtube.com",
          "i.ytimg.com",
          "yt3.ggpht.com"
        ],
        "hostlistDomains": [
          "youtube.com",
          "www.youtube.com",
          "m.youtube.com",
          "youtu.be",
          "youtubei.googleapis.com",
          "youtube-nocookie.com",
          "googlevideo.com",
          "rr1---sn-axq7sn7s.googlevideo.com",
          "ytimg.com",
          "i.ytimg.com",
          "yt3.ggpht.com",
          "ggpht.com",
          "lh3.googleusercontent.com",
          "yt3.googleusercontent.com"
        ],
        "expectedHostlists": [
          "youtube.txt",
          "youtubeGV.txt",
          "youtubeQ.txt",
          "youtube_v2.txt"
        ],
        "tcp": {
          "ports": "80,443",
          "l7": "tls",
          "payload": "tls_client_hello"
        },
        "udp": {
          "ports": "443",
          "l7": "stun",
          "payload": "binding"
        },
        "probeUrl": "https://i.ytimg.com/generate_204"
