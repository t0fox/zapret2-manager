{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Avatar page parity evidence manifest",
  "type": "object",
  "required": [
    "schema_version", "page_id", "donor_sha", "donor_files", "z2m_files",
    "donor_sections", "z2m_sections", "intentional_extensions",
    "intentional_deviations", "backend_supported", "visual_status",
    "interaction_status", "runtime_status", "browser", "checks"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "page_id": { "type": "string", "minLength": 1 },
    "donor_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "donor_files": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "z2m_files": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "donor_sections": { "type": "array", "items": { "type": "string" } },
    "z2m_sections": { "type": "array", "items": { "type": "string" } },
    "intentional_extensions": { "type": "array", "items": { "type": "string" } },
    "intentional_deviations": { "type": "array", "items": { "type": "string" } },
    "backend_supported": { "type": "boolean" },
    "visual_status": { "enum": ["EXACT", "ADAPTED_1TO1", "PARTIAL", "MISSING", "BACKEND_NOT_READY"] },
    "interaction_status": { "enum": ["EXACT", "PARITY", "PARTIAL", "MISSING", "BACKEND_NOT_READY"] },
    "runtime_status": { "enum": ["EXACT", "PARITY", "PARTIAL", "MISSING", "BACKEND_NOT_READY"] },
    "browser": {
      "type": "object",
      "required": ["1280", "768", "390"],
      "properties": {
        "1280": { "enum": ["PASS", "NOT_RUN", "FAIL"] },
        "768": { "enum": ["PASS", "NOT_RUN", "FAIL"] },
        "390": { "enum": ["PASS", "NOT_RUN", "FAIL"] }
      },
      "additionalProperties": false
    },
    "checks": {
      "type": "object",
      "required": ["console_errors", "network_404", "horizontal_overflow", "clipped_controls", "dead_controls"],
      "properties": {
        "console_errors": { "type": "integer", "minimum": 0 },
        "network_404": { "type": "integer", "minimum": 0 },
        "horizontal_overflow": { "type": "integer", "minimum": 0 },
        "clipped_controls": { "type": "integer", "minimum": 0 },
        "dead_controls": { "type": "integer", "minimum": 0 }
      }
    }
  },
  "additionalProperties": true
}
