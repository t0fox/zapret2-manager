#!/bin/sh /etc/rc.common
# Manager-owned adapter for the optional Go implementation.
# Secret is passed only through TG_SECRET. Unsupported Rust-only settings fail
# closed instead of being silently ignored.

USE_PROCD=1
START=99
STOP=10

PROG=/usr/bin/tg-ws-proxy
CONFIG_FILE=/etc/tg-ws-proxy/config.conf
SECRET_FILE=/etc/tg-ws-proxy/secret.conf
LOG_FILE=/var/log/tg-ws-proxy.log

load_manager_config() {
	[ -x "$PROG" ] || { echo "binary missing: $PROG"; return 1; }
	[ -f "$CONFIG_FILE" ] || { echo "config missing: $CONFIG_FILE"; return 1; }
	[ -f "$SECRET_FILE" ] || { echo "secret missing: $SECRET_FILE"; return 1; }

	. "$CONFIG_FILE"
	. "$SECRET_FILE"

	[ "$ENABLED" = "1" ] || return 2
	[ -n "$HOST" ] || { echo "HOST is empty"; return 1; }
	[ -n "$PORT" ] || { echo "PORT is empty"; return 1; }
	case "$SECRET" in
		????????????????????????????????) ;;
		*) echo "SECRET must be 32 hex characters"; return 1 ;;
	esac
	case "$SECRET" in
		*[!0-9a-f]*) echo "SECRET contains non-hex characters"; return 1 ;;
	esac

	[ -z "$MTPROTO_PROXIES" ] || { echo "Go provider does not support upstream MTProto proxies"; return 1; }
	[ -z "$OUTBOUND_PROXY" ] || { echo "Go provider does not support outbound proxy"; return 1; }
	[ -z "$NO_PROXY" ] || { echo "Go provider does not support noProxy"; return 1; }
	[ "$CF_BALANCE" != "1" ] || { echo "Go provider does not support CF balance"; return 1; }
	return 0
}

append_csv_flag() {
	local flag="$1" values="$2" oldifs item
	[ -n "$values" ] || return 0
	oldifs="$IFS"
	IFS=,
	for item in $values; do
		[ -n "$item" ] && procd_append_param command "$flag" "$item"
	done
	IFS="$oldifs"
}

start_service() {
	load_manager_config
	case "$?" in
		2) return 0 ;;
		0) ;;
		*) return 1 ;;
	esac

	procd_open_instance tg-ws-proxy
	procd_set_param command "$PROG" --host "$HOST" --port "$PORT"
	procd_set_param env TG_SECRET="$SECRET"

	[ -n "$POOL_SIZE" ] && procd_append_param command --pool-size "$POOL_SIZE"
	[ -n "$BUF_KB" ] && procd_append_param command --buf-kb "$BUF_KB"
	[ -n "$MAX_CONNECTIONS" ] && [ "$MAX_CONNECTIONS" != "0" ] && \
		procd_append_param command --max-conns "$MAX_CONNECTIONS"
	[ -n "$FAKETLS_DOMAIN" ] && procd_append_param command --fake-tls-domain "$FAKETLS_DOMAIN"
	[ -n "$CF_DOMAINS" ] && procd_append_param command --cfproxy-domains "$CF_DOMAINS"
	[ -n "$CF_WORKER_DOMAINS" ] && procd_append_param command --cfproxy-worker-domain "$CF_WORKER_DOMAINS"
	[ "$CF_PRIORITY" = "0" ] && procd_append_param command --cfproxy-priority=false
	[ "$DEFAULT_DOMAINS" = "0" ] && [ -z "$CF_DOMAINS$CF_WORKER_DOMAINS" ] && \
		procd_append_param command --no-cfproxy
	append_csv_flag --dc-ip "$DC_IPS"
	[ "$VERBOSE" = "1" ] && {
		procd_append_param command -v
		procd_append_param command --log-file "$LOG_FILE"
	}

	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param respawn 3600 5 5
	procd_set_param limits core="0 0"
	procd_close_instance
}

reload_service() {
	stop
	start
}
