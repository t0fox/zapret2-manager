{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/migration-manifest.schema.json",
  "title": "Migration Manifest",
  "description": "9-column deterministic record of every file moved or transformed during the vault migration.",
  "type": "array",
  "items": {
    "$ref": "#/$defs/MigrationRow"
  },
  "$defs": {
    "MigrationRow": {
      "type": "object",
      "required": [
        "OLD_PATH",
        "TYPE",
        "AUTHORITY",
        "STATUS",
        "TARGET_PATH",
        "ACTION",
        "REFERENCED_BY",
        "NOTES",
        "OLD_BLOB_SHA"
      ],
      "properties": {
        "OLD_PATH": { "type": "string" },
        "TYPE": { "type": "string", "enum": ["doc", "spec", "plan", "adr", "template", "contract", "other"] },
        "AUTHORITY": { "type": "string", "enum": ["spec", "plan", "adr", "manual", "generated"] },
        "STATUS": { "type": "string", "enum": ["pending", "done", "skipped", "blocked"] },
        "TARGET_PATH": { "type": "string" },
        "ACTION": { "type": "string", "enum": ["move", "copy", "rename", "frontmatter-update", "delete", "noop"] },
        "REFERENCED_BY": {
          "type": "array",
          "items": { "type": "string" }
        },
        "NOTES": { "type": "string" },
        "OLD_BLOB_SHA": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
      }
    }
  }
}
