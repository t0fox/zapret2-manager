{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zapret2-manager.local/contracts/status.schema.json",
  "title": "zapret2-manager status.json",
  "description": "Shape of /tmp/zapret2-manager/status.json produced by status.uc and served by ubus status. The backend computes serviceState, engine evidence, drift and health; the UI only renders them.",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema", "generatedAt", "generation", "serviceState", "engine", "runtime", "runtimeSummary", "applied", "draft", "drift", "health", "system", "upstream", "jobs", "warnings"],
  "properties": {
    "schema": { "type": "integer", "const": 3 },
    "generatedAt": { "type": ["string", "null"], "format": "date-time" },
    "generation": { "type": ["integer", "null"] },
    "serviceState": {
      "type": "string",
      "enum": ["engine_missing", "running", "stopped", "partial", "error", "paused", "passthrough"],
      "description": "Backend-computed state. engine_missing means the optional zapret2 package/runtime contract is not installed."
    },
    "engine": {
      "type": "object",
      "additionalProperties": true,
      "required": ["installed", "packagePresent", "binaryPresent", "servicePresent"],
      "properties": {
        "installed": { "type": "boolean" },
        "packagePresent": { "type": "boolean" },
        "binaryPresent": { "type": "boolean" },
        "servicePresent": { "type": "boolean" }
      }
    },
    "runtime": {
      "type": "object",
      "properties": {
        "present": { "type": "boolean" },
        "count": { "type": "integer" },
        "instances": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["pid", "cmdline"],
            "properties": {
              "pid": { "type": "integer" },
              "binary": { "type": ["string", "null"] },
              "cmdline": { "type": "string" },
              "startTime": { "type": ["string", "null"], "format": "date-time" },
              "rssKb": { "type": ["integer", "null"] }
            }
          }
        },
        "strategies": { "type": ["string", "null"] },
        "profileCount": { "type": ["integer", "null"] },
        "psSummary": { "type": "string" },
        "rulesPresent": { "type": "boolean" }
      }
    },
    "runtimeSummary": {
      "type": "object",
      "required": ["schemaVersion", "source", "status", "process", "runtime", "nfqueue"],
      "additionalProperties": true
    },
    "applied": {
      "type": "object",
      "properties": {
        "configPath": { "type": "string" },
        "configPresent": { "type": "boolean" },
        "configMtime": { "type": ["string", "null"], "format": "date-time" },
        "configSize": { "type": ["integer", "null"] },
        "uci": { "type": ["string", "null"] }
      }
    },
    "draft": { "type": "object" },
    "drift": {
      "type": "object",
      "required": ["divergent"],
      "properties": {
        "divergent": { "type": "boolean" },
        "reason": { "type": ["string", "null"] },
        "basis": { "type": "string", "enum": ["sha256-intermediate", "argv-render"] },
        "appliedSha256": {
          "type": ["object", "null"],
          "properties": {
            "config": { "type": ["string", "null"] },
            "uci": { "type": ["string", "null"] }
          }
        },
        "currentSha256": {
          "type": ["object", "null"],
          "properties": {
            "config": { "type": ["string", "null"] },
            "uci": { "type": ["string", "null"] }
          }
        },
        "normalizedRuntime": { "type": ["string", "null"] }
      }
    },
    "health": {
      "type": "object",
      "properties": {
        "qlenHealth": {
          "type": "object",
          "required": ["state", "threshold", "consecutiveOverThreshold", "critTurns"],
          "properties": {
            "state": { "type": "string", "enum": ["nominal", "warn", "critical", "unknown"] },
            "threshold": { "type": "integer", "const": 50 },
            "consecutiveOverThreshold": { "type": "integer" },
            "critTurns": { "type": "integer", "const": 3 }
          }
        },
        "checks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id"],
            "properties": {
              "id": { "type": "string", "enum": ["dns_consistency", "tls12_reachable", "udp443_quic", "queue_health", "lua_version_match"] }
            },
            "additionalProperties": true
          }
        },
        "queue": {
          "type": "object",
          "properties": {
            "number": { "type": "integer", "const": 300 },
            "registered": { "type": "boolean" },
            "reason": { "type": ["string", "null"] },
            "peerPortid": { "type": ["integer", "null"] },
            "ownerPid": { "type": ["integer", "null"] },
            "ownerConflict": { "type": "boolean" },
            "queueTotal": { "type": ["integer", "null"] },
            "copyRange": { "type": ["integer", "null"] },
            "queueDropped": { "type": ["integer", "null"] },
            "queueUserDropped": { "type": ["integer", "null"] },
            "updatedAt": { "type": ["string", "null"], "format": "date-time" }
          }
        }
      }
    },
    "system": {
      "type": "object",
      "properties": {
        "autostart": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "symlinks": { "type": "array", "items": { "type": "string" } }
          }
        },
        "upgradable": { "type": ["boolean", "null"] }
      }
    },
    "upstream": {
      "type": "object",
      "properties": {
        "nfqws2Version": { "type": ["string", "null"] },
        "autohostlist": {
          "type": ["object", "null"],
          "additionalProperties": { "type": ["string", "null"] }
        }
      }
    },
    "jobs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "status": { "type": "string", "enum": ["pending", "running", "succeeded", "failed", "rolled_back", "expired"] },
          "createdAt": { "type": ["string", "null"], "format": "date-time" },
          "updatedAt": { "type": ["string", "null"], "format": "date-time" }
        },
        "additionalProperties": true
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "anyOf": [
          { "type": "string" },
          {
            "type": "object",
            "required": ["code", "message"],
            "properties": {
              "code": { "type": "string" },
              "message": { "type": "string" },
              "severity": { "type": "string", "enum": ["info", "warn", "crit"] }
            },
            "additionalProperties": true
          }
        ]
      }
    }
  }
}
